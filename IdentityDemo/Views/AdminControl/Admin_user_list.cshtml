@model IEnumerable<IdentityDemo.Models.ApplicationUser>
@{
    Layout = "_Admin_layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Table</title>    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="~/css/download_css/5_2_3_bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/download_css/4_5_3_bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/css/download_css/1_10_24_jquery.dataTables.min.css" />
    <link href="~/css/download_css/sb_1_7_1_datatables.min.css" rel="stylesheet" />
</head>
<body>
    <div style="padding-top: 2%;">
        <table id="myTable" class="display" style="width:100%">
            <thead>
                <tr style="text-align: center;">
                    <th style="text-align: center;">No.</th>
                    <th style="text-align: center;">UserName</th>
                    <th style="text-align: center;">PhoneNumber</th>
                    <th style="text-align: center;">Role</th>
                    <th style="text-align: center;">Email</th>
                    <th style="text-align: center;">Address</th>
                    <th style="text-align: center;">Action</th>                    
                </tr>
            </thead>
        </table>
    </div>

    <!-- Modal for user delete Confirmation -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this user?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteButton">Delete</button>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        
        <script src="~/js/download_js/3_5_1_jquery.min.js"></script>
        <script type="text/javascript" src="~/js/download_js/1_10_24_jquery.dataTables.min.js"></script>
        <script src="~/js/download_js/sb_1_7_1_datatables.min.js"></script>
        <script src="~/js/download_js/5_2_3_bootstrap.bundle.min.js"></script>
        <script>

            let currentItemId;

            function setuserId(userId) {
                currentuserId = userId;
            }

            document.getElementById('confirmDeleteButton').addEventListener('click', function () {
                document.getElementById('deleteUserForm-' + currentuserId).submit();
            });


            $.fn.dataTable.ext.errMode = 'none';
            var myTable = $('#myTable').DataTable({
                processing: false,
                serverSide: true,
                ordering: false,
                scrollX: true,
                language: {
                    processing: '<div id="loadingSpinner" class="d-flex justify-content-center align-items-center" ' +
                        'style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); ' +
                        'background: rgba(255, 255, 255, 0.8); z-index: 1000; width: 100%; height: 100%;">' +
                        '<div class="spinner-border text-primary" role="status">' +
                        '<span class="visually-hidden">Loading...</span>' +
                        '</div>' +
                        '</div>'
                },
                dom:
                    "<'row'<'col-sm-12 col-md-6 d-flex justify-content-start align-items-center flex-grow-1 pt-0 pb-0 mt-2 mb-2'l>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row pt-2'<'col-sm-12 d-flex justify-content-between align-items-center'<i><p>>>",

                ajax: {
                    url: "@Url.RouteUrl("AdminUsersList.Datatable")",
                    type: "POST",
                    datatype: "json",
                    beforeSend: function () {
                        $('#myTable tbody').html('<tr><td colspan="12" class="text-center" style="position: relative; height: 100px;">' +
                            '<div class="d-flex justify-content-center align-items-center" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">' +
                            '<div class="spinner-border text-primary" role="status">' +
                            '<span class="visually-hidden">Loading...</span>' +
                            '</div>' +
                            '</div>' +
                            '</td></tr>');
                    }
                },
                columnDefs: [
                    {
                        targets: 0,
                        searchable: false,
                        orderable: false,
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            var pageInfo = myTable.page.info();
                            return pageInfo.start + meta.row + 1;
                        }
                    }
                ],
                columns: [
                    { data: "No." },
                    { data: "userName", name: "Username", autoWidth: true, className: "text-nowrap text-center" },
                    { data: "phoneNumber", name: "phonenumber", autoWidth: true, className: "text-nowrap text-center" },
                    { data: "role", name: "role", autoWidth: true, className: "text-nowrap text-center" },
                    { data: "email", name: "email", autoWidth: true, className: "text-nowrap text-center" },
                    { data: "address", name: "address", autoWidth: true, className: "text-nowrap text-center" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<a href="javascript:void(0)" class="text-danger " data-id="${row.Id}"><i class="fas fa-trash-alt"></i> </a>`;
                        },
                        width: "100px",
                        className:"text-center"
                    }
                ],
                rowId: "Id",
                order: [1, 'asc']
            });
            var oTable = $('#myTable').DataTable();
        </script>
    }
</body>
</html>
