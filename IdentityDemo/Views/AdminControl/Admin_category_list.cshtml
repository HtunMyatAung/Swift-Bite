@model IdentityDemo.ViewModels.CategoryListViewModel
@{
    Layout = "_Admin_layout";
    int counter = 1;
    var error = TempData["error_category"];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/download_css/1_10_24_jquery.dataTables.min.css" />
    <link href="~/css/download_css/sb_1_7_1_datatables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/download_css/5_2_3_bootstrap.min.css" />
    <script src="~/js/download_js/5_2_3_bootstrap.bundle.min.js"></script>
    <style>
        .github-login-form {
            margin-top: 50px;
            padding: 30px;
            border: 1px solid #e1e4e8;
            border-radius: 6px;
            background-color: transparent;
        }

        .github-label {
            font-weight: 600;
            color: #24292e;
        }

        .github-input {
            margin-bottom: 16px;
            padding: 6px 8px;
            font-size: 14px;
            line-height: 20px;
            color: #24292e;
            background-color: #fafbfc;
            border: 1px solid #e1e4e8;
            border-radius: 6px;
            box-shadow: inset 0 1px 2px rgba(27, 31, 35, 0.075);
        }

            .github-input:focus {
                border-color: #0366d6;
                box-shadow: 0 0 0 3px rgba(3, 102, 214, 0.3);
                outline: none;
            }

        .github-btn {
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            background-color: #28a745;
            border-color: rgba(27, 31, 35, 0.15);
            border-radius: 6px;
        }

            .github-btn:hover {
                background-color: #218838;
                border-color: #1e7e34;
            }

        .text-danger {
            margin-top: 5px;
            font-size: 12px;
        }
        .catinput{
            border-radius: 3px;
            border-color: gray;
            border-width: 0.9px;
            background-color: transparent;
            width: 190px; 
            height: 35px;
        }
    </style>
</head>
<body>
    <form method="post" asp-action="Admin_add_category" asp-controller="AdminControl">
        <div class="d-flex justify-content-between">
            <h3>Category List</h3>
            <div class="d-flex flex-row-reverse">
                <div class="py-2 pl-2">
                    <input id="category_name" name="category_name" type="text" required class="catinput"/>
                </div>
                <div class="p-2">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus fa-sm"></i> Add</button>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end">
            <label style="color:red; margin-right:20px"><small>@error</small></label>
        </div>
        
    </form>
    <div >
        <table id="myTable" class="display" style="width:100%">
            <thead>
                <tr style="text-align: center;">
                    <th>ID</th>
                    <th>Name</th>
                    <th>Items Count</th>
                    <th>Delete</th>
                </tr>
            </thead>            
        </table>
    </div>

    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this item?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteButton">Delete</button>                    
                </div>
            </div>
        </div>
    </div>

   @section Scripts{
   
    <script src="~/js/download_js/3_5_1_jquery.min.js"></script>
    <script type="text/javascript" src="~/js/download_js/1_10_24_jquery.dataTables.min.js"></script>
    <script src="~/js/download_js/sb_1_7_1_datatables.min.js"></script>
    <script src="~/js/download_js/5_2_3_bootstrap.bundle.min.js"></script>
    <script>
        
        let currentCategoryId;

        function setCategoryId(categoryId) {
            currentCategoryId =categoryId;
        }

        document.getElementById('confirmDeleteButton').addEventListener('click', function () {
            document.getElementById('deleteCategoryForm-' + currentCategoryId).submit();
        });

        $.fn.dataTable.ext.errMode = "none";
        var myTable = $('#myTable').DataTable({
            serverSide : true,
            processing : false,
            ordering : false,
            language: {
                processing: '<div id="loadingSpinner" class="d-flex justify-content-center align-items-center" ' +
                    'style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); ' +
                    'background: rgba(255, 255, 255, 0.8); z-index: 1000; width: 100%; height: 100%;">' +
                    '<div class="spinner-border text-primary" role="status">' +
                    '<span class="visually-hidden">Loading...</span>' +
                    '</div>' +
                    '</div>'
            },
            dom:
                "<'row'<'col-sm-12 col-md-6 d-flex justify-content-start align-items-center flex-grow-1 pt-0 pb-0 mt-2 mb-2'l>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row pt-2'<'col-sm-12 d-flex justify-content-between align-items-center'<i><p>>>",

            ajax: {
                url: "@Url.RouteUrl("AdminCategoryList.Datatable")",
                type: "POST",
                datatype: "json",
                beforeSend: function () {
                    $('#myTable tbody').html('<tr><td colspan="12" class="text-center" style="position: relative; height: 100px;">' +
                        '<div class="d-flex justify-content-center align-items-center" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">' +
                        '<div class="spinner-border text-primary" role="status">' +
                        '<span class="visually-hidden">Loading...</span>' +
                        '</div>' +
                        '</div>' +
                        '</td></tr>');
                }
            },
            columnDefs: [
                {
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    className: 'text-center',
                    render: function (data, type, row, meta) {
                        var pageInfo = myTable.page.info();
                        return pageInfo.start + meta.row + 1;
                    }
                }
            ],
            columns: [
                { data: "No." },
                { data: "name", name: "Itemname", autoWidth: true, className: "text-nowrap text-center" },
                { data: "item_count", name: "Item Count", autoWidth: true, className: "text-nowrap text-center" },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `<a href="javascript:void(0)" class="text-danger " data-id="${row.Id}"><i class="fas fa-trash-alt"></i> </a>`;
                    },
                    width: "100px",
                    className: "text-center"
                }
            ],
            rowId: "Id",
            order: [1, 'asc']
        });
        var oTable = $('#myTable').DataTable();

    </script>
   }
</body>
</html>

